{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/presentation",
      "destination": "/presentation/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/presentation/(.*)",
      "destination": "/presentation/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
