<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ambient Glow beneath the W emblem -->
    <path
        android:pathData="M 31,38 L 41,72 L 54,49 L 67,72 L 77,38"
        android:strokeWidth="11"
        android:strokeColor="#30A78BFA"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    
    <!-- Stylized Futuristic W Emblem with Gradient -->
    <path
        android:pathData="M 31,38 L 41,72 L 54,49 L 67,72 L 77,38"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="31"
                android:startY="38"
                android:endX="77"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#C4B5FD" />
                <item android:offset="0.5" android:color="#F472B6" />
                <item android:offset="1.0" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Radiant Halo for Apex Star -->
    <path
        android:pathData="M54,34.5m-5.5,0a5.5,5.5 0,1,1 11,0a5.5,5.5 0,1,1 -11,0"
        android:fillColor="#35F472B6" />

    <!-- Luminous Apex Star / AI Core -->
    <path
        android:pathData="M54,34.5m-3.8,0a3.8,3.8 0,1,1 7.6,0a3.8,3.8 0,1,1 -7.6,0"
        android:fillColor="#F472B6" />

    <path
        android:pathData="M54,34.5m-2,0a2,2 0,1,1 4,0a2,2 0,1,1 -4,0"
        android:fillColor="#FFFFFF" />
</vector>