{
  "configurations": [
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/firmware/src",
        "${workspaceFolder}/firmware/src/**",
        "${workspaceFolder}/firmware/src/libs/**",
        "${workspaceFolder}/firmware/src/libs/lvgl/**",
        "${workspaceFolder}/firmware/src/libs/nRF5_SDK_15.3.0_59ac345/components/**",
        "${workspaceFolder}/simulator/sim",
        "${workspaceFolder}/simulator/sim/**",
        "${workspaceFolder}/simulator/build/**",
        "/opt/homebrew/include/**",
        "/opt/homebrew/include/SDL2"
      ],
      "defines": [
        "MONITOR_ZOOM=1",
        "WITH_PNG"
      ],
      "macFrameworkPath": [
        "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
      ],
      "cStandard": "c11",
      "cppStandard": "c++20",
      "intelliSenseMode": "macos-clang-arm64",
      "compileCommands": "${workspaceFolder}/compile_commands.json"
    }
  ],
  "version": 4
}
